
import java.io.*;
import java.util.*;

class Car {
    private final String registrationNumber;
    private final String colour;

    public Car(String registrationNumber, String colour) {
        this.registrationNumber = registrationNumber;
        this.colour = colour;
    }

    public String getRegistrationNumber() {
        return registrationNumber;
    }

    public String getColour() {
        return colour;
    }
}

class ParkingLot {
    private final TreeSet<Integer> availableSlots = new TreeSet<>();
    private final TreeMap<Integer, Car> parkedCars = new TreeMap<>();
    private final Map<String, Integer> registrationToSlot = new HashMap<>();
    private final Map<String, TreeSet<Integer>> colourToSlots =
            new HashMap<>();

    private boolean created = false;

    public void createParkingLot(int capacity) {
        if (capacity <= 0) {
            System.out.println("Invalid parking lot capacity");
            return;
        }

        availableSlots.clear();
        parkedCars.clear();
        registrationToSlot.clear();
        colourToSlots.clear();

        for (int i = 1; i <= capacity; i++) {
            availableSlots.add(i);
        }

        created = true;
        System.out.println(
                "Created a parking lot with " + capacity + " slots");
    }

    public void park(String registrationNumber, String colour) {
        if (!created) {
            System.out.println("Please create a parking lot first");
            return;
        }

        if (registrationToSlot.containsKey(registrationNumber)) {
            System.out.println("Car is already parked");
            return;
        }

        if (availableSlots.isEmpty()) {
            System.out.println("Sorry, parking lot is full");
            return;
        }

        // Get the nearest available slot.
        int slot = availableSlots.pollFirst();

        Car car = new Car(registrationNumber, colour);
        parkedCars.put(slot, car);
        registrationToSlot.put(registrationNumber, slot);

        colourToSlots
                .computeIfAbsent(colour.toLowerCase(),
                        key -> new TreeSet<>())
                .add(slot);

        System.out.println("Allocated slot number: " + slot);
    }

    public void leave(int slot) {
        Car car = parkedCars.remove(slot);

        if (car == null) {
            System.out.println("Slot number " + slot + " is free");
            return;
        }

        registrationToSlot.remove(car.getRegistrationNumber());

        String colour = car.getColour().toLowerCase();
        TreeSet<Integer> slots = colourToSlots.get(colour);
        slots.remove(slot);

        if (slots.isEmpty()) {
            colourToSlots.remove(colour);
        }

        // Make the slot available again.
        availableSlots.add(slot);

        System.out.println("Slot number " + slot + " is free");
    }

    public void status() {
        System.out.println("Slot No. Registration No Colour");

        for (Map.Entry<Integer, Car> entry : parkedCars.entrySet()) {
            Car car = entry.getValue();

            System.out.println(
                    entry.getKey() + " " +
                    car.getRegistrationNumber() + " " +
                    car.getColour());
        }
    }

    public void registrationNumbersForColour(String colour) {
        StringJoiner result = new StringJoiner(", ");

        // Iterate in slot order for deterministic output.
        for (Car car : parkedCars.values()) {
            if (car.getColour().equalsIgnoreCase(colour)) {
                result.add(car.getRegistrationNumber());
            }
        }

        System.out.println(
                result.length() == 0 ? "Not found" : result.toString());
    }

    public void slotNumbersForColour(String colour) {
        TreeSet<Integer> slots =
                colourToSlots.get(colour.toLowerCase());

        if (slots == null || slots.isEmpty()) {
            System.out.println("Not found");
            return;
        }

        StringJoiner result = new StringJoiner(", ");

        for (int slot : slots) {
            result.add(String.valueOf(slot));
        }

        System.out.println(result);
    }

    public void slotNumberForRegistration(String registrationNumber) {
        Integer slot = registrationToSlot.get(registrationNumber);

        System.out.println(slot == null ? "Not found" : slot);
    }
}

public class Main {

    private static boolean processCommand(
            String line, ParkingLot parkingLot) {

        line = line.trim();

        if (line.isEmpty()) {
            return true;
        }

        String[] parts = line.split("\\s+");

        try {
            switch (parts[0].toLowerCase()) {

                case "create_parking_lot":
                    if (parts.length == 2) {
                        parkingLot.createParkingLot(
                                Integer.parseInt(parts[1]));
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "park":
                    if (parts.length == 3) {
                        parkingLot.park(parts[1], parts[2]);
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "leave":
                    if (parts.length == 2) {
                        parkingLot.leave(
                                Integer.parseInt(parts[1]));
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "status":
                    parkingLot.status();
                    break;

                case "registration_numbers_for_cars_with_colour":
                    if (parts.length == 2) {
                        parkingLot.registrationNumbersForColour(
                                parts[1]);
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "slot_numbers_for_cars_with_colour":
                    if (parts.length == 2) {
                        parkingLot.slotNumbersForColour(parts[1]);
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "slot_number_for_registration_number":
                    if (parts.length == 2) {
                        parkingLot.slotNumberForRegistration(
                                parts[1]);
                    } else {
                        System.out.println("Invalid command");
                    }
                    break;

                case "exit":
                    return false;

                default:
                    System.out.println("Invalid command");
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid number");
        }

        return true;
    }

    public static void main(String[] args) {
        ParkingLot parkingLot = new ParkingLot();

        try (BufferedReader reader =
                args.length > 0
                ? new BufferedReader(new FileReader(args[0]))
                : new BufferedReader(
                        new InputStreamReader(System.in))) {

            String line;

            while ((line = reader.readLine()) != null) {
                if (!processCommand(line, parkingLot)) {
                    break;
                }
            }

        } catch (IOException e) {
            System.err.println(
                    "Unable to read input: " + e.getMessage());
        }
    }
}
